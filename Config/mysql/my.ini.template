# MySQL 8.4 Community Server - generated by sync-config.bat

[client]
port=3306
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4

[mysqld]
port=3306
basedir={{FRAMEWORKS_HOME_FWD}}/Databases/Sql/mysql/current
datadir={{FRAMEWORKS_HOME_FWD}}/Databases/Sql/mysql/resources/data
log_error={{FRAMEWORKS_HOME_FWD}}/Databases/Sql/mysql/resources/logs/error.log
log_error_verbosity=3
slow_query_log=1
slow_query_log_file={{FRAMEWORKS_HOME_FWD}}/Databases/Sql/mysql/resources/logs/slow.log
long_query_time=1
character-set-server=utf8mb4
collation-server=utf8mb4_0900_ai_ci
lower_case_table_names=1
default-time-zone="+08:00"
log_timestamps=SYSTEM
bind-address=127.0.0.1
skip-name-resolve=0
local-infile=0
secure-file-priv={{FRAMEWORKS_HOME_FWD}}/Databases/Sql/mysql/resources/files
sql_mode=STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
max_connections=1000
max_connect_errors=10000
wait_timeout=28800
interactive_timeout=28800
thread_cache_size=128
table_open_cache=4000
table_definition_cache=2000
open_files_limit=65535
tmp_table_size=256M
max_heap_table_size=256M
sort_buffer_size=4M
join_buffer_size=4M
read_buffer_size=2M
read_rnd_buffer_size=4M
default_storage_engine=InnoDB
innodb_file_per_table=1
innodb_buffer_pool_size=8G
innodb_buffer_pool_instances=8
innodb_redo_log_capacity=2G
innodb_log_buffer_size=64M
innodb_flush_log_at_trx_commit=1
innodb_io_capacity=1000
innodb_io_capacity_max=2000
innodb_read_io_threads=8
innodb_write_io_threads=8
innodb_thread_concurrency=0
innodb_page_cleaners=4
innodb_purge_threads=4
innodb_lru_scan_depth=4096
transaction_isolation=READ-COMMITTED
server-id=1
log_bin={{FRAMEWORKS_HOME_FWD}}/Databases/Sql/mysql/resources/logs/mysql-bin
binlog_row_image=MINIMAL
sync_binlog=1
max_binlog_size=256M
binlog_expire_logs_seconds=604800
gtid_mode=ON
enforce_gtid_consistency=ON
performance_schema=ON

[mysqldump]
quick
max_allowed_packet=256M
