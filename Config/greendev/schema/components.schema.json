{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greendev.local/schema/components.schema.json",
  "title": "GreenDev Component Manifest",
  "type": "object",
  "required": ["schemaVersion", "components"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "enabled", "installDir", "healthPath", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "dependsOn": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "installDir": { "type": "string", "minLength": 1 },
          "currentLink": { "type": ["string", "null"] },
          "healthPath": { "type": "string", "minLength": 1 },
          "archiveRoot": { "type": "string" },
          "source": {
            "type": "object",
            "required": ["type", "archive", "sha256"],
            "properties": {
              "type": { "enum": ["archive", "msi"] },
              "url": { "type": "string" },
              "archive": { "type": "string", "pattern": "\\.(zip|7z|tar\\.gz|tgz|tar\\.xz|msi)$" },
              "sha256": { "type": "string", "pattern": "^$|^[A-Fa-f0-9]{64}$" }
            }
          }
        }
      }
    }
  }
}
